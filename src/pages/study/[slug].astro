---
import { getCollection, render } from 'astro:content'
import PostLayout from '../../layouts/PostLayout.astro'

export async function getStaticPaths() {
  const studies = await getCollection('study', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }))
}

const { study } = Astro.props
const { Content } = await render(study)
---

<PostLayout
  slug={study.id}
  title={study.data.title}
  description={study.data.description}
  pubDate={study.data.pubDate}
  updatedDate={study.data.updatedDate}
  tags={study.data.tags}
  ogImage={study.data.ogImage}
  basePath="study"
  passage={study.data.passage}
>
  <Content />
</PostLayout>
